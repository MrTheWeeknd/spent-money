# Conexão MongoDB Atlas (inclua o nome do banco no final)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/spent-money

# Hash bcrypt da senha de login. Gere com: npm run hash-password -- "minha senha"
# Cole o hash como está (o @nestjs/config não expande $).
AUTH_PASSWORD_HASH=

# Segredo para assinar o JWT (string longa e aleatória)
JWT_SECRET=troque-por-uma-string-aleatoria-longa
# Duração da sessão em dias
SESSION_DAYS=30

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Cookie "Secure" (true em produção; false permite testar via http no celular pela rede local)
COOKIE_SECURE=false

PORT=3000
